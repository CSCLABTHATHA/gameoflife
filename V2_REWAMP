import random
import time
XMAX = 40
YMAX = 20
PERCENTAGE = 10

main_data = [] #in the format of [(posx,posy),alive=true/false]


#to mess around
def percent(chance = PERCENTAGE):
    if random.randint(0,100) <= chance:
        return True
    else:
        return False


#grid 40x20
def checkSurrounding(tup):
    x,y = tup
    lis = []
    for i in range(x-1,x+2):
        for j in range(y-1,y+2):
            lis.append((i,j))


    del lis[4]
    for i in lis:
        for j in i:
            if j < 0:
                lis.remove(i)

    return lis


def createSystem(): #creates the initial system
    global main_data
    main_data = []
    for j in range(1,YMAX + 1):
        for i in range(1,XMAX + 1):
            main_data.append([(i,j),percent()])



def makeIntoCell(life):
    if life == True:
        return '0'
    else:
        return ' '


def printer():
    print('\n'*40)
    fullstring = ''
    for cell in main_data:
        x = cell[0][0]
        y = cell[0][1]
        life = cell[1]

        
        
        fullstring += makeIntoCell(life)
        if x == XMAX:
            fullstring += '\n'

            
    print(fullstring)


def main():
    while True:
        createSystem()
        #print(main_data)
        printer()
        time.sleep(0.6)

main()
